         <BibleReference reference="Habakkuk 3:2-19" type="section"/>
         <BibleReference reference="Jonah 2:1-10" type="section"/>
         <BibleReference reference="Isaiah 38:10-20" type="section"/>
         <BibleReference reference="Prayer of Manasseh 1:1-15" type="section"/>
         <BibleReference reference="Isaiah 26:9-20" type="section"/>
         <BibleReference reference="Isaiah 25:1-12" type="section"/>
         
         <!--  SOD does not include this reference -->
