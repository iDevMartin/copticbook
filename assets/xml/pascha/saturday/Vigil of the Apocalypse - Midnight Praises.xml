   <ForceSeason id="Fasts ^ PaschaWeek ^ WatosDays ^ Weekend ^ JoyousSaturday ^ Saturdays ^ FuneralTune ^ SeasonOfAirAndFruits">
      <Title>
         <Language id="English">Midnight Praises</Language>      
         <Language id="Arabic">تسبحة نصف الليل</Language>
      </Title>
      
      <Role id="Priest">
         <Comment>
            <Language id="English">
               The priest and deacons put on their service vestments, and the veil of the sanctuary is opened.  
            </Language>
         </Comment>
         
         <Comment>
            <Language id="English">
               The priest stands before the sanctuary facing the east with his head uncovered, and holds the book of Psalms, wrapped in a white linen veil and chants “<span class="Coptic">Doxaci o~ ye~oc /~mwn Al</span>” in its apocalyptic tune, followed by Psalm 151:  
            </Language>
         </Comment>
      </Role>
      
      <Role id="People">
         <InsertDocument path="include/Psalm151Chant"/>
      </Role>
      
      <Role id="Priest">
         <Comment>
            <Language id="English">
               The priest carries the book of Psalms and proceeds around the church three times with the deacons while chanting the exposition of the Second Canticle: “<span class="Coptic">Marenouwnh e~bol</span>.”  
            </Language>
         </Comment>
         
         <Comment>
            <Language id="English">
               Please note that all the Praises are chanted by alternating one verse from inside the sanctuary and one verse from outside the sanctuary.   
            </Language>
         </Comment>
      </Role>
      
      <Role id="People">
         <InsertDocument path="include/praises/PsaliAdamForSecondHoos"/>
         <InsertDocument path="include/praises/FirstHoos"/>
         
         <Comment>
            <Language id="English">
               The priest and deacons sit while having lit candles and they start reading the rest of the Old Testament praises and prophecies:   
            </Language>
         </Comment>      
      </Role>
      
      <Role id="Reader">
         <!--  SOD says Deuteronomy 32:1-42 -->
         <BibleReference reference="Deuteronomy 32:1-43" type="section"/>
         
