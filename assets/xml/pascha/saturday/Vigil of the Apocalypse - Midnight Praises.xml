      <Role id="Priest">
         <Comment>
            <Language id="English">
               The priest and deacons sit while having lit candles and they continue reading the rest of the New Testament praises and prophecies:   
            </Language>
         </Comment>      
      </Role>
      
      <Role id="Reader">
